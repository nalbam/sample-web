# Rendered to /etc/nginx/conf.d/default.conf by the nginx image entrypoint.
# Only ${PORT} and ${VERSION} are substituted (NGINX_ENVSUBST_FILTER).

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers for every response: pages, /health, 404 and errors.
    # "always" adds them to error responses too. A location with its own
    # add_header does not inherit these, so keep add_header out of locations.
    # The CSP allows only the hosts that src/index.html uses; change it with
    # the CDN URLs. Do not put "$" in these values: envsubst renders this file.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://code.jquery.com https://nalbam.com; style-src 'self' https://cdn.jsdelivr.net https://use.fontawesome.com; font-src https://use.fontawesome.com; img-src 'self' https://nalbam.com data:; connect-src 'self' https://nalbam.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"result":"ok","version":"${VERSION}"}\n';
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
